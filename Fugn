-- aimbot
--------------------------------------------------------------------------------
local AIM = { enabled = CFG.aim.enabled, holding = false, fovCircle = nil }

if CFG.aim.showFov then
    if renderer == "drawing" then
        AIM.fovCircle = drawing("Circle", {
            Visible = CFG.aim.showFov, Thickness = 1,
            Color = CFG.aim.fovColor, Transparency = CFG.aim.fovTransparency,
            Filled = false, NumSides = 60,
        })
    else
        AIM.fovCircle = new("Frame", {
            BackgroundTransparency = 1, BorderSizePixel = 1,
            BorderColor3 = CFG.aim.fovColor, Visible = CFG.aim.showFov,
            Size = UDim2.fromOffset(CFG.aim.fov * 2, CFG.aim.fov * 2),
            AnchorPoint = Vector2.new(0.5, 0.5), Parent = espGui,
        })
        new("UICorner", { CornerRadius = UDim.new(1, 0) }, AIM.fovCircle)
    end
end

local function bestTarget()
    local best, bestScore = nil, math.huge
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local myRoot = hrp(LP)
    if not myRoot then return nil end
    for p, t in pairs(ESP.target) do
        if not t.onScreen then goto continue end
        if p == LP then goto continue end
        if CFG.aim.teamCheck and sameTeam(p) then goto continue end
        if not alive(p) then goto continue end
        if CFG.aim.wallCheck then
            local part = char(p) and char(p):FindFirstChild(CFG.aim.part)
            if not isVisible(part) then goto continue end
        end
        local screenPos = t.screen
        local d2 = (screenPos - center).Magnitude
        if d2 > CFG.aim.fov then goto continue end
        local worldDist = (t.pos - myRoot.Position).Magnitude
        local score = d2 + worldDist * 0.05
        if score < bestScore then
            bestScore = score
            best = p
        end
        ::continue::
    end
    return best
end

local function aimStep(dt)
    if AIM.holding then
        local target = bestTarget()
        if target then
            local c = char(target)
            local part = c and c:FindFirstChild(CFG.aim.part)
            if not part then return end
            local vel = part.AssemblyLinearVelocity or Vector3.zero
            local predict = vel * CFG.aim.prediction
            local pos = part.Position + predict
            local current = Camera.CFrame
            local look = CFrame.new(current.Position, pos)
            local alpha = math.clamp(dt * CFG.aim.smooth, 0, 1)
            Camera.CFrame = current:Lerp(look, alpha)
        end
    end
    if AIM.fovCircle and renderer == "drawing" then
        AIM.fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        AIM.fovCircle.Radius = CFG.aim.fov
        AIM.fovCircle.Visible = CFG.aim.showFov and CFG.aim.enabled
    elseif AIM.fovCircle and renderer == "gui" then
        AIM.fovCircle.Visible = CFG.aim.showFov and CFG.aim.enabled
        AIM.fovCircle.Size = UDim2.fromOffset(CFG.aim.fov * 2, CFG.aim.fov * 2)
        AIM.fovCircle.BorderColor3 = CFG.aim.fovColor
    end
end

RunService.RenderStepped:Connect(function(dt)
    safe(aimStep, dt)
end)

UserInput.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == CFG.aim.key then
        AIM.holding = true
    end
end)
UserInput.InputEnded:Connect(function(input, gp)
    if input.UserInputType == CFG.aim.key then
        AIM.holding = false
    end
end)

