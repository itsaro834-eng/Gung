            Text = label, BackgroundTransparency = 1,
            Position = UDim2.fromOffset(12, 4), Size = UDim2.new(1, -60, 0, 16),
            TextColor3 = CFG.menu.text, Font = CFG.menu.font, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)
        local valueLabel = new("TextLabel", {
            Text = tostring(get()), BackgroundTransparency = 1,
            Position = UDim2.new(1, -60, 0, 4), Size = UDim2.fromOffset(48, 16),
            TextColor3 = CFG.menu.accent, Font = CFG.menu.fontB, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Right,
        }, row)
        local barBg = new("Frame", {
            Size = UDim2.new(1, -24, 0, 6), Position = UDim2.fromOffset(12, 26),
            BackgroundColor3 = CFG.menu.panel2, BorderSizePixel = 0,
        }, row)
        new("UICorner", { CornerRadius = UDim.new(1, 0) }, barBg)
        local fill = new("Frame", {
            Size = UDim2.new((get() - min) / (max - min), 0, 1, 0),
            BackgroundColor3 = CFG.menu.accent, BorderSizePixel = 0,
        }, barBg)
        new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
        local hit = new("TextButton", {
            Text = "", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        }, row)

        local function applyFromX(x)
            local rel = math.clamp((x - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
            local v = min + (max - min) * rel
            v = math.floor(v * 100 + 0.5) / 100
            set(v)
            valueLabel.Text = tostring(v)
            fill.Size = UDim2.new(rel, 0, 1, 0)
        end

        local dragging = false
        hit.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true; applyFromX(i.Position.X)
            end
        end)
        hit.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
        UserInput.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                applyFromX(i.Position.X)
            end
        end)
    end

    builders.esp = function(parent)
        makeToggle(parent, "enabled", function() return ESP.enabled end,
            function(v) ESP.enabled = v; CFG.esp.enabled = v end, 1)
        makeToggle(parent, "boxes", function() return CFG.esp.boxes end,
            function(v) CFG.esp.boxes = v end, 2)
        makeToggle(parent, "names", function() return CFG.esp.names end,
            function(v) CFG.esp.names = v end, 3)
        makeToggle(parent, "health bars", function() return CFG.esp.health end,
            function(v) CFG.esp.health = v end, 4)
        makeToggle(parent, "distance", function() return CFG.esp.distance end,
            function(v) CFG.esp.distance = v end, 5)
        makeToggle(parent, "tracers", function() return CFG.esp.tracers end,
            function(v) CFG.esp.tracers = v end, 6)
        makeToggle(parent, "team check", function() return CFG.esp.teamCheck end,
            function(v) CFG.esp.teamCheck = v end, 7)
        makeSlider(parent, "max distance", 50, 2000,
            function() return CFG.esp.maxDist end,
            function(v) CFG.esp.maxDist = v end, 8)
    end

    builders.aim = function(parent)
        makeToggle(parent, "enabled", function() return AIM.enabled end,
            function(v) AIM.enabled = v; CFG.aim.enabled = v end, 1)
        makeToggle(parent, "team check", function() return CFG.aim.teamCheck end,
            function(v) CFG.aim.teamCheck = v end, 2)
        makeToggle(parent, "wall check", function() return CFG.aim.wallCheck end,
            function(v) CFG.aim.wallCheck = v end, 3)
        makeToggle(parent, "show fov", function() return CFG.aim.showFov end,
            function(v) CFG.aim.showFov = v end, 4)
        makeSlider(parent, "fov", 10, 800,
            function() return CFG.aim.fov end,
            function(v) CFG.aim.fov = v end, 5)
        makeSlider(parent, "smooth", 1, 30,
            function() return CFG.aim.smooth end,
            function(v) CFG.aim.smooth = v end, 6)
        makeSlider(parent, "prediction", 0, 1,
            function() return CFG.aim.prediction end,
            function(v) CFG.aim.prediction = v end, 7)
    end

    builders.misc = function(parent)
        local info = new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = CFG.menu.panel,
            BorderSizePixel = 0, TextColor3 = CFG.menu.sub, Font = CFG.menu.font,
            TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
            Text = "  renderer: " .. renderer .. "   |   version: " .. VERSION,
        }, parent)
        new("UICorner", { CornerRadius = UDim.new(0, 5) }, info)
        local fpsRow = new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = CFG.menu.panel,
            BorderSizePixel = 0, TextColor3 = CFG.menu.sub, Font = CFG.menu.font,
            TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
            Text = "  fps: —", LayoutOrder = 2,
        }, parent)
        new("UICorner", { CornerRadius = UDim.new(0, 5) }, fpsRow)
        RunService.RenderStepped:Connect(function()
            safe(function()
                fpsRow.Text = "  fps: " .. tostring(math.floor(1 / RunService.RenderStepped:Wait() or 60))
            end)
        end)

        local unload = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = CFG.menu.panel,
            BorderSizePixel = 0, TextColor3 = CFG.menu.enemy,
            Font = CFG.menu.fontB, TextSize = 13, Text = "unload",
            LayoutOrder = 3,
        }, parent)
        new("UICorner", { CornerRadius = UDim.new(0, 5) }, unload)
        unload.MouseButton1Click:Connect(function()
            safe(function()
                ESP.enabled = false
                AIM.enabled = false
                for p in pairs(ESP.objects) do espRemove(p) end
                if Menu.gui then Menu.gui:Destroy() end
                if espGui then espGui:Destroy() end
                if getgenv().Vault then getgenv().Vault = nil end
            end)
        end)
    end

    Menu.builders = builders

    -- toggle
    UserInput.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == CFG.menu.toggleKey then
            Menu.visible = not Menu.visible
            Menu.main.Visible = Menu.visible
        end
    end)

    Menu.setTab("esp")
end

safe(buildMenu)

getgenv().Vault = {
    version = VERSION,
    esp     = ESP,
    aim     = AIM,
    menu    = Menu,
    config  = CFG,
    unload  = function()
        for p in pairs(ESP.objects) do espRemove(p) end
        if Menu.gui then Menu.gui:Destroy() end
        if espGui then espGui:Destroy() end
        getgenv().Vault = nil
    end,
}

print(("[vault] loaded v%s  renderer=%s  executor-level=7"):format(VERSION, renderer))
