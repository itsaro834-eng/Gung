    }, title)

    local close = new("TextButton", {
        Text = "×", Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -36, 0, 6),
        BackgroundColor3 = CFG.menu.panel2, TextColor3 = CFG.menu.text,
        Font = CFG.menu.fontB, TextSize = 16, AutoButtonColor = true,
    }, title)
    new("UICorner", { CornerRadius = UDim.new(0, 6) }, close)
    close.MouseButton1Click:Connect(function() Menu.visible = false; Menu.main.Visible = false end)

    -- drag
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Menu.dragging = true
            local start = input.Position
            local origin = Menu.main.Position
            local moveConn, endConn
            moveConn = UserInput.InputChanged:Connect(function(m)
                if m.UserInputType == Enum.UserInputType.MouseMovement then
                    local delta = m.Position - start
                    Menu.main.Position = UDim2.new(origin.X.Scale, origin.X.Offset + delta.X,
                                                   origin.Y.Scale, origin.Y.Offset + delta.Y)
                end
            end)
            endConn = UserInput.InputEnded:Connect(function(e)
                if e.UserInputType == Enum.UserInputType.MouseButton1 then
                    Menu.dragging = false
                    moveConn:Disconnect()
                    endConn:Disconnect()
                end
            end)
        end
    end)

    -- tabs
    local tabBar = new("Frame", {
        Size = UDim2.new(1, -20, 0, CFG.menu.tabH),
        Position = UDim2.fromOffset(10, 46),
        BackgroundColor3 = CFG.menu.panel,
        BorderSizePixel = 0,
    }, Menu.main)
    new("UICorner", { CornerRadius = UDim.new(0, 6) }, tabBar)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 4),
