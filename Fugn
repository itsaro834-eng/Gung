    new("TextLabel", {
        Text = CFG.menu.title .. "  " .. VERSION,
        Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -100, 1, 0),
        BackgroundTransparency = 1, TextColor3 = CFG.menu.text,
        TextXAlignment = Enum.TextXAlignment.Left, Font = CFG.menu.fontB,
