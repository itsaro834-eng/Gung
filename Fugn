        Name = "Main",
        Size = UDim2.fromOffset(CFG.menu.width, CFG.menu.height),
        Position = UDim2.new(0.5, -CFG.menu.width / 2, 0.5, -CFG.menu.height / 2),
        BackgroundColor3 = CFG.menu.bg,
        BorderSizePixel = 0,
        Active = true,
    }, Menu.gui)
    new("UICorner", { CornerRadius = UDim.new(0, 8) }, Menu.main)
    new("UIStroke", { Color = CFG.menu.accent, Transparency = 0.6, Thickness = 1 }, Menu.main)

    -- title bar
    local title = new("Frame", {
        Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = CFG.menu.panel,
        BorderSizePixel = 0,
    }, Menu.main)
    new("UICorner", { CornerRadius = UDim.new(0, 8) }, title)
