-- esp
--------------------------------------------------------------------------------
local ESP = {
    objects = {},   -- [player] = { ... }
    target  = {},   -- shared target list for aim (hrp + pos)
    enabled = CFG.esp.enabled,
}

local espGui
local function espMakeGUI()
    if renderer ~= "gui" then return end
    espGui = new("ScreenGui", { Name = "VaultESP", ResetOnSpawn = false,
                                IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling },
                (pcall(function() return CoreGui end) and CoreGui) or LP:WaitForChild("PlayerGui"))
end
espMakeGUI()

local function espDraw(p)
    local s = {}
    if renderer == "drawing" then
        s.box    = drawing("Square", { Visible = false, Thickness = 1, Filled = false })
        s.name   = drawing("Text",   { Visible = false, Size = CFG.esp.textSize, Center = true, Outline = true, Font = 2 })
        s.dist   = drawing("Text",   { Visible = false, Size = CFG.esp.textSize - 2, Center = true, Outline = true, Font = 2 })
        s.hBg    = drawing("Square", { Visible = false, Thickness = 1, Filled = true, Color = Color3.fromRGB(30,30,34) })
        s.hFg    = drawing("Square", { Visible = false, Thickness = 1, Filled = true })
        s.tracer = drawing("Line",   { Visible = false, Thickness = 1, Transparency = 0.35 })
    else
        s.box    = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 1,
                                  BorderColor3 = CFG.esp.accent, Visible = false }, espGui)
        s.name   = new("TextLabel", { BackgroundTransparency = 1, TextColor3 = CFG.esp.text,
                                      TextSize = CFG.esp.textSize, Font = CFG.menu.font,
                                      TextStrokeTransparency = 0.4, Visible = false }, espGui)
        s.dist   = new("TextLabel", { BackgroundTransparency = 1, TextColor3 = CFG.esp.text,
                                      TextSize = CFG.esp.textSize - 2, Font = CFG.menu.font,
                                      TextStrokeTransparency = 0.4, Visible = false }, espGui)
        s.hBg    = new("Frame", { BackgroundColor3 = Color3.fromRGB(30,30,34),
                                  BorderSizePixel = 0, Visible = false }, espGui)
        s.hFg    = new("Frame", { BackgroundColor3 = CFG.esp.team,
                                  BorderSizePixel = 0, Visible = false }, espGui)
        s.tracer = new("Frame", { BackgroundColor3 = CFG.esp.accent,
                                  BorderSizePixel = 0, Visible = false }, espGui)
    end
    return s
end

local function espRemove(p)
    local s = ESP.objects[p]
    if not s then return end
    for _, o in pairs(s) do
        if o and o.Remove then o:Remove() elseif o and o.Destroy then o:Destroy() end
    end
    ESP.objects[p] = nil
end

local function espColor(p)
    if CFG.esp.teamCheck and sameTeam(p) then return CFG.esp.team end
    return CFG.esp.enemy
end

local function espUpdate(p)
    if not alive(p) or p == LP then
        local s = ESP.objects[p]
        if s then
            for _, o in pairs(s) do
                if o.Visible ~= nil then o.Visible = false end
            end
        end
        return
    end
    local root = hrp(p); local h = hum(p)
    if not root or not h then return end

    local myRoot = hrp(LP)
    if not myRoot then return end
    local dist = (root.Position - myRoot.Position).Magnitude
    if dist > CFG.esp.maxDist then
        local s = ESP.objects[p]
        if s then for _, o in pairs(s) do if o.Visible ~= nil then o.Visible = false end end end
        return
    end

    local s = ESP.objects[p]
    if not s then s = espDraw(p); ESP.objects[p] = s end

    local headPos = root.Position + Vector3.new(0, root.Size.Y / 2 + 0.5, 0)
    local feetPos = root.Position - Vector3.new(0, root.Size.Y / 2, 0)
    local top2, onTop, topZ = w2v(headPos)
    local bot2, onBot, botZ = w2v(feetPos)
    local drawable = onTop and onBot and topZ > 0 and botZ > 0

    if not drawable then
        for _, o in pairs(s) do if o.Visible ~= nil then o.Visible = false end end
        return
    end

    local boxH = bot2.Y - top2.Y
    local boxW = boxH * 0.55
    local boxX = top2.X - boxW / 2
    local boxY = top2.Y

    local col = espColor(p)

    if CFG.esp.boxes then
        if renderer == "drawing" then
            s.box.Position = Vector2.new(boxX, boxY)
            s.box.Size     = Vector2.new(boxW, boxH)
            s.box.Color    = col
            s.box.Visible  = true
        else
            s.box.Position = UDim2.fromOffset(boxX, boxY)
            s.box.Size     = UDim2.fromOffset(boxW, boxH)
            s.box.BorderColor3 = col
            s.box.Visible  = true
        end
    else
        s.box.Visible = false
    end

    if CFG.esp.names then
        local txt = p.Name
        if renderer == "drawing" then
            s.name.Text = txt
            s.name.Position = Vector2.new(top2.X, top2.Y - CFG.esp.textSize - 4)
            s.name.Color = CFG.esp.text
            s.name.Visible = true
        else
            s.name.Text = txt
            s.name.Position = UDim2.fromOffset(top2.X - 100, top2.Y - CFG.esp.textSize - 4)
            s.name.Size = UDim2.fromOffset(200, CFG.esp.textSize + 2)
            s.name.TextXAlignment = Enum.TextXAlignment.Center
            s.name.Visible = true
        end
    else
        s.name.Visible = false
    end

    if CFG.esp.distance then
        local dtxt = tostring(math.floor(dist)) .. "m"
        if renderer == "drawing" then
            s.dist.Text = dtxt
            s.dist.Position = Vector2.new(top2.X, bot2.Y + 2)
            s.dist.Color = CFG.esp.text
            s.dist.Visible = true
        else
            s.dist.Text = dtxt
            s.dist.Position = UDim2.fromOffset(top2.X - 60, bot2.Y + 2)
            s.dist.Size = UDim2.fromOffset(120, CFG.esp.textSize)
            s.dist.TextXAlignment = Enum.TextXAlignment.Center
            s.dist.Visible = true
        end
    else
        s.dist.Visible = false
    end

    if CFG.esp.health then
        local pct = math.clamp(h.Health / h.MaxHealth, 0, 1)
        local hW, hH = 3, boxH
        local hX = boxX - 6
        if renderer == "drawing" then
            s.hBg.Position = Vector2.new(hX, boxY)
            s.hBg.Size     = Vector2.new(hW, hH)
            s.hBg.Visible  = true
            s.hFg.Position = Vector2.new(hX, boxY + hH * (1 - pct))
            s.hFg.Size     = Vector2.new(hW, hH * pct)
            s.hFg.Color    = Color3.fromRGB(90, 220, 110):Lerp(Color3.fromRGB(230, 60, 60), 1 - pct)
            s.hFg.Visible  = true
        else
            s.hBg.Position = UDim2.fromOffset(hX, boxY)
            s.hBg.Size     = UDim2.fromOffset(hW, hH)
            s.hBg.Visible  = true
            s.hFg.Position = UDim2.fromOffset(hX, boxY + hH * (1 - pct))
            s.hFg.Size     = UDim2.fromOffset(hW, hH * pct)
            s.hFg.BackgroundColor3 = Color3.fromRGB(90, 220, 110):Lerp(Color3.fromRGB(230, 60, 60), 1 - pct)
            s.hFg.Visible  = true
        end
    else
        s.hBg.Visible = false
        s.hFg.Visible = false
    end

    if CFG.esp.tracers then
        local vp = Camera.ViewportSize
        local bottom = Vector2.new(vp.X / 2, vp.Y)
        if renderer == "drawing" then
            s.tracer.From = bottom
            s.tracer.To   = Vector2.new(top2.X, bot2.Y)
            s.tracer.Color = col
            s.tracer.Visible = true
        else
            local from, to = bottom, Vector2.new(top2.X, bot2.Y)
            local d = to - from
            local len = d.Magnitude
            local ang = math.deg(math.atan2(d.Y, d.X))
            s.tracer.Position = UDim2.fromOffset((from.X + to.X) / 2 - len / 2, (from.Y + to.Y) / 2 - 1)
            s.tracer.Size     = UDim2.fromOffset(len, 1)
            s.tracer.Rotation = ang
            s.tracer.BackgroundColor3 = col
            s.tracer.Visible  = true
        end
    else
        s.tracer.Visible = false
    end

    -- publish to aim target list
    ESP.target[p] = { hrp = root, pos = root.Position, head = headPos, screen = top2, onScreen = drawable }
end

local function espLoop()
    for p in pairs(ESP.objects) do
        if not p.Parent or p == LP then espRemove(p) end
    end
    ESP.target = {}
    if ESP.enabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then safe(espUpdate, p) end
        end
    else
        for _, s in pairs(ESP.objects) do
            for _, o in pairs(s) do if o.Visible ~= nil then o.Visible = false end end
        end
    end
end

RunService.RenderStepped:Connect(function()
    safe(espLoop)
end)

Players.PlayerRemoving:Connect(espRemove)

