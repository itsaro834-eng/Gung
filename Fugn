        Size = UDim2.new(1, -20, 1, -20 - CFG.menu.tabH - 46),
        Position = UDim2.fromOffset(10, 46 + CFG.menu.tabH + 6),
        BackgroundTransparency = 1,
    }, Menu.main)
    Menu.content = content

    local function makeTab(name, order)
        local btn = new("TextButton", {
            Text = name, Size = UDim2.fromOffset(84, CFG.menu.tabH - 8),
            BackgroundColor3 = CFG.menu.panel2, TextColor3 = CFG.menu.sub,
            Font = CFG.menu.font, TextSize = 12, LayoutOrder = order,
            AutoButtonColor = false,
        }, tabBar)
        new("UICorner", { CornerRadius = UDim.new(0, 5) }, btn)
        Menu.tabs[name] = { button = btn, frame = nil }
        btn.MouseButton1Click:Connect(function() Menu.setTab(name) end)
    end

    function Menu.setTab(name)
        Menu.active = name
        for n, t in pairs(Menu.tabs) do
            if n == name then
                t.button.BackgroundColor3 = CFG.menu.accent
                t.button.TextColor3 = CFG.menu.text
                if not t.frame then
                    t.frame = new("Frame", {
                        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                        Visible = true,
                    }, Menu.content)
                    new("UIListLayout", {
                        Padding = UDim.new(0, 6),
                        SortOrder = Enum.SortOrder.LayoutOrder,
                    }, t.frame)
                    Menu.builders[name](t.frame)
                end
                t.frame.Visible = true
            else
                t.button.BackgroundColor3 = CFG.menu.panel2
                t.button.TextColor3 = CFG.menu.sub
                if t.frame then t.frame.Visible = false end
            end
        end
    end

